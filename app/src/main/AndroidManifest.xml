<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fully offline: no INTERNET permission on purpose.
         No CAMERA permission either: photos are taken by the system camera app
         (ACTION_IMAGE_CAPTURE into our FileProvider), images are picked with the Photo Picker. -->

    <!-- Android 11+ package visibility: lets TextToSpeech find and bind the system TTS engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.NekoTranslate">
        <!-- Experimental GPU acceleration: the vendor OpenCL driver (Adreno). Android 12+ only lets
             apps load vendor public libraries they declare; optional, so devices without it are fine. -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统分享图片：走主界面图片翻译（文本分享和选中文字走下面的悬浮翻译卡片） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 悬浮翻译卡片：在当前 App 上方弹出，不进入主界面。
             PROCESS_TEXT 由调用方 startActivityForResult 启动，留在调用方任务里（standard 启动模式，
             「替换」的结果才能送回）；分享（NEW_TASK）时 taskAffinity="" 让它单独成一个任务。
             excludeFromRecents：关闭后回到原 App，最近任务里不留卡片。 -->
        <activity
            android:name=".ui.quick.QuickTranslateActivity"
            android:exported="true"
            android:label="@string/quick_label"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="standard"
            android:noHistory="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NekoTranslate.Quick">
            <!-- 选中文字菜单「NekoTranslate 翻译」 -->
            <intent-filter android:label="@string/quick_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 系统分享：文本 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Hands the camera app a content:// URI to write the photo to (cache/camera/). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
