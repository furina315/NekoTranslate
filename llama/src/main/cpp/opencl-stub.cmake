# Link-time stand-in for the device's libOpenCL.so (experimental Adreno GPU backend, arm64-v8a).
#
# ggml's OpenCL backend is built as a dynamically loaded module (GGML_BACKEND_DL) that links
# against "libOpenCL.so". At run time that name resolves to the vendor's library
# (/vendor/lib64/libOpenCL.so on Snapdragon; the manifest declares it with <uses-native-library>),
# and the app opens the module only when the user turns GPU acceleration on. On a device without
# OpenCL the dlopen() simply fails and the app stays on the CPU.
#
# For linking we only need *a* libOpenCL.so exporting the core API names. Instead of building the
# Khronos ICD loader we generate a stub from the Khronos headers: one exported function per
# `CL_API_CALL clXxx(` in CL/cl.h, each returning CL_PLATFORM_NOT_FOUND_KHR (-1001). The stub has
# SONAME libOpenCL.so, no symbol versioning (so references bind to any vendor build) and must never
# ship in the APK (app/build.gradle.kts excludes it; release.yml checks). Even if it did, every call
# fails with "no platform" and ggml reports no OpenCL device instead of crashing.
#
# Usage: lt_opencl_stub(<OpenCL-Headers dir>) -> target lt_opencl_stub (+ alias OpenCL::OpenCL)

function(lt_opencl_stub HEADERS_DIR)
    set(cl_h "${HEADERS_DIR}/CL/cl.h")
    if (NOT EXISTS "${cl_h}")
        message(FATAL_ERROR "OpenCL headers missing at ${HEADERS_DIR}. Run: git submodule update --init --recursive")
    endif()
    file(READ "${cl_h}" code)
    string(REGEX MATCHALL "CL_API_CALL[ \t\r\n]+cl[A-Za-z0-9_]+[ \t\r\n]*\\(" calls "${code}")
    set(names "")
    foreach(c IN LISTS calls)
        string(REGEX REPLACE "^CL_API_CALL[ \t\r\n]+(cl[A-Za-z0-9_]+).*$" "\\1" n "${c}")
        list(APPEND names "${n}")
    endforeach()
    list(REMOVE_DUPLICATES names)
    list(LENGTH names count)
    if (count LESS 50)
        message(FATAL_ERROR "OpenCL stub: only ${count} functions found in ${cl_h}")
    endif()

    set(src "/* Generated by llama/src/main/cpp/opencl-stub.cmake from ${cl_h}. Do not ship. */\n")
    string(APPEND src "#define LT_STUB(name) __attribute__((visibility(\"default\"))) long name(void) { return -1001; }\n")
    foreach(n IN LISTS names)
        string(APPEND src "LT_STUB(${n})\n")
    endforeach()
    set(out "${CMAKE_CURRENT_BINARY_DIR}/lt-opencl-stub/opencl_stub.c")
    set(old "")
    if (EXISTS "${out}")
        file(READ "${out}" old)
    endif()
    if (NOT old STREQUAL src)
        file(WRITE "${out}" "${src}")
    endif()

    add_library(lt_opencl_stub SHARED "${out}")
    # Own output directory, away from the folder the Android Gradle plugin packages .so files from.
    set_target_properties(lt_opencl_stub PROPERTIES
            OUTPUT_NAME OpenCL
            LIBRARY_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/lt-opencl-stub"
            C_VISIBILITY_PRESET hidden)
    add_library(OpenCL::OpenCL ALIAS lt_opencl_stub)
    message(STATUS "NekoTranslate: OpenCL link stub with ${count} entry points from ${cl_h}")
endfunction()
